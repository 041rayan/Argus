<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<AnchorPane fx:id="root"
            prefHeight="640.0" prefWidth="900.0"
            styleClass="root-pane"
            xmlns="http://javafx.com/javafx/21.0.8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.argus.ui.controller.ExportController">
    <children>
        <Label styleClass="title-label" text="Export">
            <AnchorPane.leftAnchor>24.0</AnchorPane.leftAnchor>
            <AnchorPane.topAnchor>24.0</AnchorPane.topAnchor>
        </Label>

        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <AnchorPane.leftAnchor>24.0</AnchorPane.leftAnchor>
            <AnchorPane.rightAnchor>24.0</AnchorPane.rightAnchor>
            <AnchorPane.topAnchor>66.0</AnchorPane.topAnchor>
            <children>
                <ComboBox fx:id="targetCombo" prefHeight="32.0" prefWidth="320.0"
                          promptText="Target" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="formatCombo" prefHeight="32.0" prefWidth="130.0"/>
                <Button mnemonicParsing="false" onAction="#onExport" prefHeight="32.0" text="Export"/>
            </children>
        </HBox>

        <Label fx:id="statusLabel" styleClass="status-label" text="">
            <AnchorPane.leftAnchor>24.0</AnchorPane.leftAnchor>
            <AnchorPane.topAnchor>112.0</AnchorPane.topAnchor>
        </Label>

        <Button mnemonicParsing="false" onAction="#onBack" text="Back">
            <AnchorPane.leftAnchor>24.0</AnchorPane.leftAnchor>
            <AnchorPane.bottomAnchor>20.0</AnchorPane.bottomAnchor>
        </Button>
    </children>
</AnchorPane>
