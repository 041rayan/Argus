<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<AnchorPane fx:id="root"
            prefHeight="280.0" prefWidth="420.0"
            styleClass="root-pane"
            xmlns="http://javafx.com/javafx/21.0.8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.argus.ui.controller.AddApiKeyController">
    <children>
        <VBox spacing="12.0">
            <AnchorPane.leftAnchor>32.0</AnchorPane.leftAnchor>
            <AnchorPane.rightAnchor>32.0</AnchorPane.rightAnchor>
            <AnchorPane.topAnchor>32.0</AnchorPane.topAnchor>
            <children>
                <Label styleClass="title-label" text="API Keys"/>
                <Label fx:id="statusLabel" styleClass="status-label" text="Loading…"/>
                <ComboBox fx:id="providerCombo" prefHeight="32.0"/>
                <PasswordField fx:id="keyField" prefHeight="32.0" promptText="API key (never displayed after save)"/>
                <Label fx:id="messageLabel" styleClass="status-label" text=""/>
                <Button fx:id="saveButton" mnemonicParsing="false" onAction="#onSave" prefHeight="32.0" text="Save"/>
                <Button fx:id="removeButton" mnemonicParsing="false" onAction="#onRemove" prefHeight="32.0" text="Remove"/>
                <Button mnemonicParsing="false" onAction="#onClose" prefHeight="32.0" text="Close"/>
            </children>
        </VBox>
    </children>
</AnchorPane>
