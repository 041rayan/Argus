<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<AnchorPane fx:id="root"
            prefHeight="640.0" prefWidth="900.0"
            styleClass="root-pane"
            xmlns="http://javafx.com/javafx/21.0.8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.argus.ui.controller.EntryPointsController">
    <children>
        <Label styleClass="title-label" text="Entry points">
            <AnchorPane.leftAnchor>24.0</AnchorPane.leftAnchor>
            <AnchorPane.topAnchor>24.0</AnchorPane.topAnchor>
        </Label>

        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <AnchorPane.leftAnchor>24.0</AnchorPane.leftAnchor>
            <AnchorPane.rightAnchor>24.0</AnchorPane.rightAnchor>
            <AnchorPane.topAnchor>66.0</AnchorPane.topAnchor>
            <children>
                <ComboBox fx:id="scanCombo" prefHeight="32.0" prefWidth="460.0"
                          promptText="Scan" HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>

        <TableView fx:id="entryTable">
            <AnchorPane.leftAnchor>24.0</AnchorPane.leftAnchor>
            <AnchorPane.rightAnchor>24.0</AnchorPane.rightAnchor>
            <AnchorPane.topAnchor>112.0</AnchorPane.topAnchor>
            <AnchorPane.bottomAnchor>64.0</AnchorPane.bottomAnchor>
            <columns>
                <TableColumn prefWidth="60.0" text="Rank">
                    <cellValueFactory>
                        <PropertyValueFactory property="rank"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="300.0" text="Host:Port">
                    <cellValueFactory>
                        <PropertyValueFactory property="hostPort"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="120.0" text="Service">
                    <cellValueFactory>
                        <PropertyValueFactory property="service"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="320.0" text="KEV">
                    <cellValueFactory>
                        <PropertyValueFactory property="kev"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="80.0" text="Score">
                    <cellValueFactory>
                        <PropertyValueFactory property="score"/>
                    </cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <Button mnemonicParsing="false" onAction="#onBack" text="Back">
            <AnchorPane.leftAnchor>24.0</AnchorPane.leftAnchor>
            <AnchorPane.bottomAnchor>20.0</AnchorPane.bottomAnchor>
        </Button>
    </children>
</AnchorPane>
